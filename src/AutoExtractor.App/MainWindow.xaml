<Window x:Class="AutoExtractor.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AutoExtractor · 自动解压" Width="1160" Height="780" MinWidth="950" MinHeight="650" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver" Closing="Window_Closing">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#172236"><Grid Margin="25,32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel><Border Background="#2C5DE3" CornerRadius="12" Width="44" Height="44" HorizontalAlignment="Left"><TextBlock Text="↓" FontSize="30" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="AutoExtractor" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,18,0,5"/><TextBlock Text="自动解压助手" Foreground="#A8B7CD" FontSize="12"/></StackPanel>
      <Border Grid.Row="1" Background="#283B59" CornerRadius="7" Margin="-8,42,-8,0" Padding="14,13"><TextBlock Text="▤    解压工作台" Foreground="White"/></Border>
      <StackPanel Grid.Row="3"><TextBlock Text="本地处理 · 文件不上传" Foreground="#CAD5E5" FontSize="11"/><TextBlock Text="ZIP / 7z / RAR" Foreground="#8495AE" FontSize="11" Margin="0,8,0,0"/><TextBlock Text="v0.1.1" Foreground="#8495AE" FontSize="11" Margin="0,22,0,0"/></StackPanel>
    </Grid></Border>
    <Grid Grid.Column="1" Margin="32,27,32,23"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="155"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,22"><Border DockPanel.Dock="Right" VerticalAlignment="Top" Background="#E4F1E9" CornerRadius="12" Padding="11,5"><TextBlock Text="●  离线就绪" Foreground="#267048" FontSize="11"/></Border><StackPanel><TextBlock Text="解开层层包装。" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="识别真实格式，整理分卷，连续解压。" Foreground="#6D788B" Margin="0,8,0,0"/></StackPanel></DockPanel>
      <Border Grid.Row="1" Background="#EDF2FE" BorderBrush="#BCD0FC" BorderThickness="1" CornerRadius="10" Padding="22,18" Margin="0,0,0,18"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="AddFilesButton" Content="添加文件" Click="AddFiles_Click" Style="{StaticResource PrimaryButton}"/><Button x:Name="AddFolderButton" Content="选择文件夹" Click="AddFolder_Click" Margin="0"/></StackPanel><StackPanel VerticalAlignment="Center"><TextBlock Text="将文件或文件夹拖到这里" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="支持跨子文件夹找齐分卷，后缀伪装也能识别" Foreground="#61718E" FontSize="12" Margin="0,7,0,0"/></StackPanel></DockPanel></Border>
      <Grid Grid.Row="2" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="保存位置" VerticalAlignment="Center" Margin="0,0,14,0"/><TextBox x:Name="OutputBox" Grid.Column="1" ToolTip="留空时保存到输入目录旁的 AutoExtractor_Output"/><TextBlock Grid.Column="1" Text="默认：压缩包所在目录 / AutoExtractor_Output" IsHitTestVisible="False" Foreground="#8A95A6" Margin="11,0,0,0" FontSize="11" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=OutputBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Button x:Name="OutputBrowseButton" Grid.Column="2" Content="更改" Click="OutputBrowse_Click" Margin="8,0,0,0"/></Grid>
      <Border Grid.Row="3" Background="White" BorderBrush="#E2E6ED" BorderThickness="1" CornerRadius="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="18,14"><TextBlock x:Name="CountLabel" Text="任务列表  /  0" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="ClearButton" Content="清空列表" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="Clear_Click" Padding="8,4" FontSize="11" Margin="0"/></DockPanel><ListView x:Name="TaskList" Grid.Row="1" BorderThickness="0" Margin="8,0,8,8" SelectionChanged="TaskList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="8,12"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle><ListView.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/><ColumnDefinition Width="135"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding Included}" VerticalAlignment="Center" ToolTip="勾选此任务参与解压"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Foreground="#7B8595" FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding FormatLabel}" Foreground="#596B89" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/></Grid></DataTemplate></ListView.ItemTemplate></ListView><StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="等待添加文件" Foreground="#65738A" FontSize="17" HorizontalAlignment="Center"/><TextBlock Text="先扫描预览，再还原文件名并解压" Foreground="#9AA3B0" Margin="0,10,0,15" FontSize="12"/></StackPanel></Grid></Border>
      <Grid Grid.Row="4" Margin="0,15,0,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,8"><TextBlock Text="处理详情" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="GroupButton" Content="调整分卷" Padding="9,5" FontSize="11" Click="Group_Click"/><Button x:Name="ContinueButton" Content="继续解压内层" Padding="9,5" FontSize="11" Click="Continue_Click"/><Button x:Name="RestoreButton" Content="恢复原名" Padding="9,5" FontSize="11" Click="Restore_Click" Margin="0"/></StackPanel></DockPanel><TextBox x:Name="DetailsBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="#EBEEF3" Foreground="#516079" FontSize="11" Text="添加文件后，这里会显示识别结果和拟还原名称。"/><ProgressBar x:Name="ProgressBar" Grid.Row="2" Height="4" Margin="0,9,0,0" Minimum="0" Maximum="100" Foreground="#2459E0" Background="#E1E6EF" BorderThickness="0"/></Grid>
      <DockPanel Grid.Row="5"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="OpenButton" Content="打开结果" Click="Open_Click"/><Button x:Name="CancelButton" Content="取消" IsEnabled="False" Click="Cancel_Click"/><Button x:Name="StartButton" Content="开始解压" Click="Start_Click" Style="{StaticResource PrimaryButton}" Margin="0"/></StackPanel><TextBlock x:Name="StatusLabel" Text="就绪 · 原文件保留，改名可恢复" Foreground="#758197" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/></DockPanel>
    </Grid>
  </Grid>
</Window>
